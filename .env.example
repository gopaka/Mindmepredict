# ==============================================================================
# MindMePredict — Environment Configuration Template
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
# ==============================================================================

# External Host Port to expose on EC2 (Use 8000 or set to 80 for standard web port)
HOST_PORT=8000

# Institutional Desk Operator Credentials
DESK_USERNAME=admin
DESK_PASSWORD=nifty2026
DESK_FULLNAME=Quant Risk Lead

# Session Signing Secret Key (Optional)
# If left blank, a secure 256-bit key is automatically generated and saved to /app/data/.secret_key
# To generate your own key, run: openssl rand -hex 32
TERMINAL_SECRET_KEY=

# ------------------------------------------------------------------------------
# Optional Indian Broker Credentials (Can also be configured via Web UI)
# ------------------------------------------------------------------------------
# Zerodha Kite Connect
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Upstox
UPSTOX_API_KEY=
UPSTOX_ACCESS_TOKEN=

# Angel One SmartAPI
ANGEL_CLIENT_CODE=
ANGEL_API_KEY=
ANGEL_PIN=
ANGEL_TOTP_KEY=

